#!/bin/sh
# Licensed to the Apache Software Foundation (ASF)
# Maven Wrapper launch script for Unix/Linux/macOS
# Required: JAVA_HOME set or java in PATH

set -e
MAVEN_PROJECTBASEDIR="${BASEDIR:=$(dirname "$0")}"
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

if [ -f "$WRAPPER_JAR" ]; then
    exec java -jar "$WRAPPER_JAR" "$@"
else
    # Wrapper JAR not present: download Maven
    echo "Maven Wrapper JAR not found. Downloading Maven..."
    DOWNLOAD_URL=$(grep -E '^distributionUrl=' "$WRAPPER_PROPERTIES" | cut -d'=' -f2)
    DEST="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-dist.zip"
    mkdir -p "$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
    curl -sSL "$DOWNLOAD_URL" -o "$DEST"
    unzip -q "$DEST" -d "$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
    MVN="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/apache-maven-3.9.6/bin/mvn"
    chmod +x "$MVN"
    exec "$MVN" "$@"
fi
