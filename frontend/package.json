{
  "name": "tvk-technologies-training-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TVK Technologies - Full-Stack Training & Placement Portal built with Angular 18 and Express.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "ng serve --proxy-config proxy.conf.json --open",
    "mock": "tsx mock/server.ts",
    "e2e": "node e2e/full-portal-suite.e2e.cjs",
    "e2e:portal": "node e2e/portal-sanity-verification.e2e.cjs",
    "e2e:banner": "node e2e/banner-scroll.e2e.cjs",
    "e2e:auth": "node e2e/auth-role-transitions.e2e.cjs",
    "e2e:carousel": "node e2e/announcements-carousel.e2e.cjs",
    "e2e:modal": "node e2e/modal-scroll-lock-containment.e2e.cjs",
    "e2e:scroll": "node e2e/scroll-responsiveness-deadzones.e2e.cjs",
    "e2e:sticky": "node e2e/sticky-architecture-viewport.e2e.cjs",
    "e2e:marquee": "node e2e/tech-marquee-motion.e2e.cjs",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "5.5.4"
  }
